{
  "name": "lablink",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests scripts --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed": "tsx scripts/seed.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && node scripts/check-repo-size.mjs"
  },
  "dependencies": {
    "@google/genai": "3.6.1",
    "bcryptjs": "3",
    "better-sqlite3": "12",
    "next": "15",
    "react": "19",
    "react-dom": "19",
    "zod": "^4.6.7"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1",
    "@types/better-sqlite3": "7",
    "@types/node": "22",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitest/coverage-v8": "3.2.7",
    "autoprefixer": "10",
    "eslint": "9",
    "eslint-config-next": "15",
    "postcss": "^8.5.23",
    "prettier": "3",
    "tailwindcss": "3",
    "tsx": "4",
    "typescript": "5",
    "vitest": "3"
  }
}
